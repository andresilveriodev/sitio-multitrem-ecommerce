# Variáveis de Ambiente - Sítio Multitrem
# Copie este arquivo para .env.local e preencha com os valores corretos

# URL da API Backend
# Exemplo para produção: https://api.sitio-multitrem.com/api
# Exemplo para desenvolvimento: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# URL da aplicação (para callbacks e redirects)
# Exemplo para produção: https://sitio-multitrem.netlify.app
# Exemplo para desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keycloak Client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=sitio-multitrem-app
