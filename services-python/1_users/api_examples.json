    "get_settings": "GET http://localhost:8001/api/v1/users/{user_id}/settings",
    "get_complete_profile": "GET http://localhost:8001/api/v1/users/{user_id}/complete",
    "get_activities": "GET http://localhost:8001/api/v1/users/{user_id}/activities",
    "acl_check": "POST http://localhost:8001/api/v1/acl/check",
    "user_logout": "POST http://localhost:8001/api/v1/auth/logout"
  },
