# ============================================
# Server Configuration
# ============================================
AI_SERVICE_PORT=8003
CORS_ORIGINS=*
# Ou especifique origens especÃ­ficas separadas por vÃ­rgula:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Database Configuration
# ============================================
DATABASE_URI=postgresql://postgres:senha@localhost:5434/nome_do_banco
# Exemplo: DATABASE_URI=postgresql://postgres:123456@localhost:5434/ecommerce_ai

# ============================================
# OpenAI Configuration (ChatGPT)
# ============================================
OPENAI_API_KEY=sk-proj-SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-4o-mini
# Modelos disponÃ­veis: gpt-4o-mini, gpt-4o, gpt-4, gpt-3.5-turbo, gpt-5-nano

# ============================================
# DeepSeek Configuration
# ============================================
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Ollama Configuration (Local)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Requer Ollama instalado localmente

# ============================================
# Gemini Google Configuration (Opcional)
# ============================================
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-pro

# ============================================
# AI Provider Configuration
# ============================================
# Provedor padrÃ£o: openai, deepseek, ollama
DEFAULT_AI_PROVIDER=openai

# ============================================
# Logging Configuration (Opcional)
# ============================================
LOG_LEVEL=INFO
# NÃ­veis: DEBUG, INFO, WARNING, ERROR, CRITICAL
