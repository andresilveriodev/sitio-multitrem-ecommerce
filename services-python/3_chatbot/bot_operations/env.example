# Configurações básicas do Chatbot Service
DEBUG=false
HOST=0.0.0.0
PORT=8011
LOG_LEVEL=INFO

# AI Service (serviço existente)
AI_SERVICE_URL=http://localhost:8005
AI_SERVICE_TIMEOUT=30

# Market Data Service (cotações em tempo real)
MARKET_DATA_SERVICE_URL=http://localhost:8000
MARKET_DATA_SERVICE_TIMEOUT=10

# Commerce Service (processamento de pedidos do e-commerce)
COMMERCE_SERVICE_URL=http://localhost:8002
COMMERCE_SERVICE_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/9

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_HOSTS=["*"]

# Banco de dados
DATABASE_URL=postgresql://postgres:123456@localhost:5434/sitio_multitrem

# Telegram Bot Token (para autenticação de webhooks)
TELEGRAM_BOT_TOKEN=seu_token_aqui


