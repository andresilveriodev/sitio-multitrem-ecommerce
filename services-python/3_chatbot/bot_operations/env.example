# Configurações básicas do Chatbot Service
DEBUG=false
HOST=0.0.0.0
PORT=8011
LOG_LEVEL=INFO

# AI Service (serviço existente)
AI_SERVICE_URL=http://localhost:8005
AI_SERVICE_TIMEOUT=30

# Market Data Service (cotações em tempo real)
MARKET_DATA_SERVICE_URL=http://localhost:8000
