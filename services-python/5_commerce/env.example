# Configurações básicas
DEBUG=false
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# Configurações de segurança
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Configurações do Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=sitio-multitrem
KEYCLOAK_CLIENT_ID=commerce-service
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_VALIDATE_TOKEN=true

# Configurações do banco de dados
DATABASE_URI=postgresql://postgres:123456@localhost:5434/sitio_multitrem
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Configurações do Redis para cache
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Configurações de cache
CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=600

# Configurações de CORS
CORS_ORIGINS=["*"]
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Configurações de rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Configurações de auditoria
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=INFO
