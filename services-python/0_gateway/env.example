# Gateway Service Configuration

# Debug mode
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8000

# Microservices URLs
USER_SERVICE_URL=http://localhost:8001

# Keycloak Configuration
KEYCLOAK_AUTH_SERVER_URL=https://auth.rendacontinua.com/auth
KEYCLOAK_REALM=auth_sso
KEYCLOAK_ISSUER=https://auth.rendacontinua.com/auth/realms/auth_sso

# Microservices URLs
# User Service (Gestão de usuários, Autenticação e autorização)
USER_SERVICE_URL=http://localhost:8001

# Authentication Service (Desativado - estava na porta 8002)
# AUTH_SERVICE_URL=http://localhost:8002

# Redis Configuration (para streaming de cotações)
# Opção 1: Usar REDIS_URL (recomendado)
REDIS_URL=redis://localhost:6379/1

# Opção 2: Usar host/port/db separados (fallback se REDIS_URL não estiver definida)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=1

# CORS Configuration (opcional - se não definido, usa padrão)
# Separe múltiplas origens por vírgula
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
