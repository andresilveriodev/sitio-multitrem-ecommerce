# Configurações básicas
DEBUG=false
HOST=127.0.0.1
PORT=8020
LOG_LEVEL=INFO

# Segredo do webhook Evolution (query ?token= ou header X-Webhook-Secret)
EVOLUTION_WEBHOOK_SECRET=altere-este-segredo-localmente

# Instância na Evolution (filtro opcional; vazio = aceita qualquer)
EVOLUTION_INSTANCE_NAME=sitio-multitrem

# Evolution outbound (sendText)
EVOLUTION_API_URL=https://wpp-api.rendacontinua.com
EVOLUTION_API_KEY=
EVOLUTION_SEND_TIMEOUT=30

# Chatbot Users (forward de mensagens IN)
CHATBOT_SERVICE_URL=http://localhost:8010
CHATBOT_SERVICE_TIMEOUT=30

# Ops do gateway
RECENT_EVENTS_LIMIT=50
DEDUPE_TTL_SECONDS=600

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8003
