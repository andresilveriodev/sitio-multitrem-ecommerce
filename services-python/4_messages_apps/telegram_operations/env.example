# Configurações básicas
DEBUG=false
HOST=0.0.0.0
PORT=8021
LOG_LEVEL=INFO

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chatbot Service
CHATBOT_SERVICE_URL=http://localhost:8002
CHATBOT_SERVICE_TIMEOUT=30

# User Service / Gateway (para autenticação de usuários)
GATEWAY_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001

# Keycloak OAuth Configuration (do projeto Java b3/telegram)
KEYCLOAK_AUTH_SERVER_URL=https://auth.rendacontinua.com/auth
KEYCLOAK_REALM=auth_sso
KEYCLOAK_CLIENT_ID=auth_client
KEYCLOAK_CLIENT_SECRET=e56cf527-d5d9-4b52-bd9f-1e87c8f288de
KEYCLOAK_REDIRECT_URI=http://localhost:8021/telegram/auth/callback
KEYCLOAK_SCOPE=openid profile email offline_access
SERVICE_BASE_URL=http://localhost:8021

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis (opcional)
REDIS_URL=redis://localhost:6379/10

# Autenticação obrigatória (padrão: false - permite mensagens sem autenticação)
# Se true, apenas usuários autenticados poderão usar o bot
# Se false, o bot responderá mesmo sem autenticação (mas sem token de acesso)
REQUIRE_AUTH=false
